    "the Ab3-E4 sones hump is the clarinet's natural registers per Max) but",
    "under the production instrumentKey. See decisions.md rounds 10-12.",
    "Rebuild with:",
    "node apps/analyzer/cli/generate-samples.js apps/analyzer/configs/fatboy-clarinet-ship.json --bundle"
  ]
}
