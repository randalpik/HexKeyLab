{
  "instrumentKey": "clarinet",
  "displayName": "Clarinet",
  "baseUrl": "https://gleitz.github.io/midi-js-soundfonts/FatBoy/clarinet-mp3/",
  "ext": ".mp3",
  "filePattern": "{NOTE}.mp3",
  "noteStyle": "flat",
  "lowOct": 2,
  "highOct": 6,
