#!/usr/bin/env bash
# hkltrim — trim an OBS session recording into a loop-ready mp4 with HKL defaults.
#
#   hkltrim TITLE            onset table for the last take (pick the end from it)
#   hkltrim TITLE +0.5 -p    audition the seam: end = last onset + 0.5 s
#   hkltrim TITLE +0.5       encode  ~/Videos/Lumatone/TITLE.mp4
#   hkltrim TITLE 446.20     end at an absolute source time
#   hkltrim TITLE -0.1       end = last onset - 0.1 s
#   hkltrim TITLE -l         take list
#
# Flags: -p preview, -l list, -f overwrite an existing mp4 (refused otherwise), -n print the
# command only. Anything else is passed to trim.py (--take 1-2, --fade-out 0.01, ...).
# Directories: $HKL_OBS_DIR (default ~/Videos/obs), $HKL_LIB_DIR (default ~/Videos/Lumatone).
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
trim="$here/trim.py"
obs=${HKL_OBS_DIR:-$HOME/Videos/obs}
lib=${HKL_LIB_DIR:-$HOME/Videos/Lumatone}

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
[[ $# -ge 1 ]] || usage 1
[[ $1 == -h || $1 == --help ]] && usage 0

title=$1; shift
src="$obs/$title.mkv"
out="$lib/$title.mp4"
[[ -f $src ]] || { echo "hkltrim: no such recording: $src" >&2; exit 1; }

end=""; mode=""; force=0; dry=0; passthru=()
if [[ $# -ge 1 && $1 =~ ^(\+|-)?[0-9]+(\.[0-9]+)?$ ]]; then
  case $1 in
    +*) end="last$1" ;;         # +0.5  -> last+0.5
    -*) end="last$1" ;;         # -0.1  -> last-0.1
    *)  end="$1" ;;             # 446.2 -> absolute source time
  esac
  shift
elif [[ $# -ge 1 && $1 == last* ]]; then
  end=$1; shift
fi
for a in "$@"; do
  case $a in
    -p) mode=preview ;;
    -l) mode=list ;;
    -f) force=1 ;;
    -n) dry=1 ;;
    *)  passthru+=("$a") ;;
  esac
done

cmd=(python3 "$trim" "$src" "$out")
case $mode in
  list)    cmd+=(--list) ;;
  preview) [[ -n $end ]] || { echo "hkltrim: -p needs an end (+D, -D or seconds)" >&2; exit 1; }
           cmd+=(--end "$end" --preview) ;;
  *)       if [[ -z $end ]]; then cmd+=(--onsets)
           else
             if [[ -e $out && $force -ne 1 ]]; then
               echo "hkltrim: $out exists — it may be a posted video; pass -f to overwrite" >&2; exit 2
             fi
             cmd+=(--end "$end")
           fi ;;
esac
cmd+=("${passthru[@]}")

if [[ $dry -eq 1 ]]; then printf '%q ' "${cmd[@]}"; echo; exit 0; fi
exec "${cmd[@]}"
